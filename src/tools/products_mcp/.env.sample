# Azure Cosmos DB Configuration
COSMOS_DB_ENDPOINT=https://<account-name>.documents.azure.com:443/
COSMOS_DB_NAME=appdb

# Authentication
# Leave empty to use DefaultAzureCredential (Managed Identity in Azure)
# COSMOS_DB_KEY=<optional-key-for-local-dev>

# Azure OpenAI / AI Foundry Configuration for Embeddings
# Leave empty to use mock embeddings (for testing without embeddings model)
EMBEDDINGS_ENDPOINT=https://<foundry-name>.services.ai.azure.com/models
EMBEDDINGS_DEPLOYMENT=text-embedding-3-large
EMBEDDINGS_DIMENSIONS=2048
EMBEDDINGS_API_VERSION=2024-08-01-preview

# Vector Search Settings
VECTOR_TOP_K=20
MIN_SIMILARITY_THRESHOLD=0.5

# Ranking Weights
SIMILARITY_WEIGHT=0.55
POPULARITY_WEIGHT=0.15
PRICE_WEIGHT=0.15
AVAILABILITY_WEIGHT=0.15

# Logging
LOG_LEVEL=INFO
